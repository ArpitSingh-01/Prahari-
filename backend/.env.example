# Copy to .env for local runs. Never commit real secrets.
# Leave SUPABASE_URL empty for local mode: an in-memory store, scans lost
# on restart (the full test suite runs this way).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Explicit origins only — '*' entries are stripped. In production set this
# to the Vercel domain.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4567
MAX_UPLOAD_MB=25
# Bounded ThreadPoolExecutor width + in-process semaphore: caps simultaneous
# analyses so the 512 MB free instance cannot self-DoS.
MAX_CONCURRENT_ANALYSES=2
