# Copy to .env for local runs. Never commit real secrets.
# Leave SUPABASE_URL empty for local mode: dev-<user> bearer tokens and an
# in-memory store (the full test suite runs this way).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# HS256 fallback when Supabase JWKS cannot be fetched (legacy JWT signing key)
SUPABASE_JWT_SECRET=
# Explicit origins only — '*' entries are stripped (credentialed CORS
# requires concrete origins). In production set this to the Vercel domain.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
MAX_UPLOAD_MB=25
# Bounded ThreadPoolExecutor width + in-process semaphore: caps simultaneous
# analyses so the 512 MB free instance cannot self-DoS.
MAX_CONCURRENT_ANALYSES=2
# Reserved: optional LLM enrichment key (not used by the current pipeline)
LLM_API_KEY=
